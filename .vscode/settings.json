{
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },

  "python.testing.pytestEnabled": true,
  "python.analysis.typeCheckingMode": "basic",

  "cSpell.words": [
    "mypy",
    "pycache",
    "venv",
    "ipynb",
    "unittests",
    "airflowenv",
    "tfstate",
    "tfvars",
    "mlflow",
    "mlruns",
    "mlflowenv",
    "envrc",
    "joblib",
    "onnx",
    "ehthumbs",
    "pytest",
    "htmlcov",
    "mlops",
    "FastAPI",
    "uvicorn",
    "nbstripout",
    "pyproject",
    "devcontainer",
    "precommit",
    "pylint",
    "flake8",
    "Dockerfiles",
    "astextplain",
    "Makefiles",
    "dmypy",
    "esbenp",
    "dutour",
    "mathieu",
    "toolsai",
    "charliermarsh",
    "env",
    "DVC"
  ]
}
