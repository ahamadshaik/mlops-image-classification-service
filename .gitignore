# .gitignore for MLOps Project - Optimized for Collaboration and Reproducibility

# === Python Compiled Files & Build Artifacts ===
# Ignore Python bytecode, compiled files, and packaging outputs
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/

# === Virtual Environments ===
# Ignore commonly named virtual environment directories
.venv/
env/
venv/
# Poetry's specific virtual environment location (often within project or global cache)
.poetry/

# === VS Code Specific Files ===
# Ignore user-specific VS Code files that shouldn't be shared
.vscode/launch.json
.vscode/*.code-workspace
# NOTE: .vscode/settings.json and .vscode/extensions.json are often COMMITTED for consistent
# team setup (e.g., shared linters, formatters, recommended extensions).
# Only ignore if they contain purely personal preferences NOT relevant to the project.

# === Jupyter Notebooks Checkpoints ===
# Ignore Jupyter's temporary checkpoint files
.ipynb_checkpoints/

# === DVC (Data Version Control) ===
# Ignore DVC's local cache and temporary files - DO NOT COMMIT actual data
.dvc/cache/
.dvc/tmp/
# Common directories for DVC-managed data. Git will ignore contents, DVC tracks metadata.
# NOTE: The actual data files in these directories are ignored by Git, but DVC tracks their metadata.
data/raw/
data/interim/
data/processed/
# Prevents Git from creating nested .gitignore files within DVC-tracked data directories
data/**/.gitignore
# CRITICAL: DVC's metadata files (*.dvc) and pipeline definitions (dvc.yaml, dvc.lock) MUST be COMMITTED to Git.
# Do NOT add *.dvc or dvc.yaml/dvc.lock here.

# === Airflow Specific Files ===
# Ignore local Airflow database, configuration, and logs
airflow/airflow.db
airflow/airflow.cfg
airflow/unittests.cfg
airflow/logs/
airflow/plugins/__pycache__/
airflow/.env
airflow/.airflowenv
airflow/__pycache__/

# === Terraform Infrastructure-as-Code Files ===
# Ignore Terraform state files (should be managed via remote backends)
*.tfstate
*.tfstate.backup
# Ignore variable definition files that often contain sensitive data
# If you have non-sensitive *.tfvars that you want to commit (e.g., example.tfvars),
# you will need to explicitly un-ignore them using `!filename.tfvars`.
*.tfvars
# Ignore Terraform's module and provider cache
.terraform/
# CRITICAL: .terraform.lock.hcl MUST be COMMITTED for consistent deployments and provider versions!
# Do NOT add .terraform.lock.hcl here.

# === Docker Files ===
# Ignore miscellaneous Docker-related temporary files
**/.Python
docker-compose.override.yml
docker-compose.local.yml
# Ignore general files ending with .dockerfile (often temporary)
*.dockerfile
# CRITICAL: Dockerfile.* (e.g., Dockerfile.dev, Dockerfile.prod) and docker/.dockerignore
# are crucial for builds and MUST be COMMITTED if they are part of your project's build logic.
# Do NOT add Dockerfile.* or docker/.dockerignore here if they are important.

# === MLflow Artifacts ===
# Ignore local MLflow runs, database, and environment files
mlflow/mlruns/
mlflow/database/
mlflow/.env
mlflow/.mlflowenv

# === Secrets & Environment Variables ===
# Ignore common patterns for sensitive environment files and keys
.env
.env.*
.envrc
*.key
*.pem
*.crt

# === Model Artifacts ===
# Ignore large model binaries or serializations (should be managed by DVC or an artifact store)
saved_models/
*.h5
*.pt
*.pth
*.joblib
*.pkl
*.onnx

# === Logs & Reports ===
# Ignore general log files and generated reports
*.log
logs/
reports/
evidently_report.html
# NOTE: If you have small, non-generated CSV files (e.g., lookup tables, small datasets
# not managed by DVC) that you want to commit, remove `*.csv` entirely or make it more specific
# (e.g., `output/*.csv`, `generated/*.csv`).
# As `data/` is handled by DVC, this line is often not needed.
# *.csv

# === System Files ===
# Ignore OS-specific temporary or hidden files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# === IDE Specific Files ===
# Ignore IDE-specific project files (e.g., JetBrains IDEs)
.idea/
*.iml

# === Test Artifacts ===
# Ignore files generated by testing and code coverage tools
.coverage
pytest_cache/
htmlcov/
.tox/

# === CI/CD Cache & Logs ===
# Ignore CI/CD specific cache directories and workflow logs
.github/workflows/*.log
.cache/

# === Demo Files ===
# Ignore data or output specific to demonstrations (often large or generated)
demo/data/
demo/output/

# === GitOps-related Secrets ===
# Ignore sensitive credential directories for GitOps tools
kubernetes/argocd/.credentials/
